generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id                    String               @id @default(cuid())
  email                 String               @unique
  name                  String?
  password              String?
  role                  Role                 @default(REFEREE)
  country               String?
  level                 String?
  image                 String?
  authProvider          String               @default("credentials")
  profileComplete       Boolean              @default(false)
  isActive              Boolean              @default(true)
  disabledAt            DateTime?
  lastLoginAt           DateTime?
  emailVerified         DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  // Federation hierarchy. A referee belongs to one national association and
  // may additionally belong to one international federation (FIFA, UEFA, ...)
  // with a category (rank) inside it.
  associationId         String?
  rankId                String?
  internationalAssociationId String?
  internationalRankId   String?
  // Physical profile (used by the stats profile card)
  dateOfBirth           DateTime?
  heightCm              Int?
  weightKg              Int?
  association           Association?         @relation("UserAssociation", fields: [associationId], references: [id], onDelete: SetNull)
  rank                  Rank?                @relation("UserRank", fields: [rankId], references: [id], onDelete: SetNull)
  internationalAssociation Association?      @relation("UserInternationalAssociation", fields: [internationalAssociationId], references: [id], onDelete: SetNull)
  internationalRank     Rank?                @relation("UserInternationalRank", fields: [internationalRankId], references: [id], onDelete: SetNull)
  accounts              Account[]
  mandatoryTestsCreated MandatoryTest[]
  testSessions          TestSession[]
  trainingAssignments   TrainingAssignment[]
  testCompletions       UserTestCompletion[]
  uploadedVideos        VideoClip[]
  questionFavorites     QuestionFavorite[]
  videoTestsCreated     VideoTest[]
  videoTestSessions     VideoTestSession[]
  videoTestCompletions  VideoTestCompletion[]
  aiPromptConfigs       AiPromptConfig[]
  aiGenerationFeedback  AiGenerationFeedback[]
  searchQueryLogs       SearchQueryLog[]
  arClipsCreated        ArClip[]
  arTestSessions        ArTestSession[]

  @@index([associationId])
  @@index([rankId])
  @@index([internationalAssociationId])
}

// A football association / federation (e.g. "Israel FA", "Italian FA").
// Referees belong to one association; admins manage a single association.
// isInternational = true marks confederations (FIFA, UEFA, CAF, ...) that can
// be assigned to referees *in addition to* their national association.
model Association {
  id                   String          @id @default(cuid())
  name                 String          @unique
  countryCode          String?         // ISO 3166-1 alpha-2, drives the flag
  isInternational      Boolean         @default(false)
  isActive             Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  ranks                Rank[]
  members              User[]          @relation("UserAssociation")
  internationalMembers User[]          @relation("UserInternationalAssociation")
  videoClips           VideoClip[]
  questions            Question[]
  mandatoryTests       MandatoryTest[]
  videoTests           VideoTest[]
}

// An ordered rank/category within an association (e.g. "Elite", "Category 1").
// International federations (Association.isInternational) use the same model
// for their categories (e.g. UEFA Elite, UEFA First Category).
model Rank {
  id                   String       @id @default(cuid())
  name                 String
  order                Int          @default(0)
  associationId        String?
  isActive             Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  association          Association? @relation(fields: [associationId], references: [id], onDelete: Cascade)
  members              User[]       @relation("UserRank")
  internationalMembers User[]       @relation("UserInternationalRank")

  @@index([associationId, order])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Category {
  id                  String               @id @default(cuid())
  name                String               @unique
  slug                String               @unique
  type                CategoryType
  description         String?
  order               Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  libraryArticles     LibraryArticle[]
  mandatoryTests      MandatoryTest[]
  questions           Question[]
  testSessions        TestSession[]
  trainingAssignments TrainingAssignment[]
  videoClips          VideoClip[]
}

model VideoClip {
  id                  String          @id @default(cuid())
  title               String
  fileUrl             String
  thumbnailUrl        String?
  duration            Int?
  categoryId          String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  commonMistakes      String[]        @default([])
  correctDecision     String?
  decisionExplanation String?
  description         String?
  isActive            Boolean         @default(true)
  isEducational       Boolean         @default(false) // True = explanation only, no decision
  isFeatured          Boolean         @default(false)
  keyPoints           String[]        @default([])
  lawNumbers          Int[]           @default([])
  offsideReason       OffsideReason?  // For offside-specific clips
  order               Int             @default(0)
  playOn              Boolean         @default(false) // Display "Play On" as title in answer
  noOffence           Boolean         @default(false) // Display "No Offence" as title in answer
  restartType         RestartType?
  sanctionType        SanctionType?
  uploadedById        String?
  varNotes            String?
  varRelevant         Boolean         @default(false)
  videoCategoryId     String?
  videoType           VideoType       @default(EDUCATIONAL)
  viewCount           Int             @default(0)
  // Video editing metadata
  trimStart           Float?          // Start time in seconds (for trimming from beginning)
  trimEnd             Float?          // End time in seconds (for trimming from end)
  cutSegments         Json?           // Array of {start, end} objects for cut sections
  loopZoneStart       Float?          // Suggested loop start time in seconds
  loopZoneEnd         Float?          // Suggested loop end time in seconds
  // AI semantic search fields (embedding column managed via raw SQL / pgvector)
  rawAdminDescription     String?
  canonicalSearchText     String?
  searchSummary           String?
  searchKeywords          String[]    @default([])
  searchDescriptionStatus String      @default("none")
  searchDescriptionLang   String?
  aiProcessedAt           DateTime?
  aiProcessedById         String?
  // Federation scope: null = global (e.g. RAP-edition clips).
  associationId       String?
  questions           Question[]
  category            Category        @relation(fields: [categoryId], references: [id])
  uploadedBy          User?           @relation(fields: [uploadedById], references: [id])
  videoCategory       VideoCategory?  @relation(fields: [videoCategoryId], references: [id])
  association         Association?    @relation(fields: [associationId], references: [id], onDelete: SetNull)
  tags                VideoTag[]
  videoTestClips      VideoTestClip[]
  aiGenerationFeedback AiGenerationFeedback[]

  @@index([videoCategoryId, order])
  @@index([lawNumbers])
  @@index([isActive, isFeatured])
  @@index([associationId])
}

model Question {
  id            String         @id @default(cuid())
  type          QuestionType
  categoryId    String
  videoClipId   String?
  text          String
  explanation   String
  difficulty    Int            @default(1)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  isActive      Boolean        @default(true)
  isUpToDate    Boolean        @default(false)
  isIfab        Boolean        @default(true)
  lawNumbers    Int[]          @default([])
  isVar         Boolean        @default(false)
  // Federation scope: null = global. IFAB questions stay global; non-IFAB
  // questions may be scoped to a single association.
  associationId String?
  answerOptions AnswerOption[]
  category      Category       @relation(fields: [categoryId], references: [id])
  videoClip     VideoClip?     @relation(fields: [videoClipId], references: [id])
  association   Association?   @relation(fields: [associationId], references: [id], onDelete: SetNull)
  testAnswers   TestAnswer[]
  favorites     QuestionFavorite[]

  @@index([categoryId, type, isActive])
  @@index([lawNumbers])
  @@index([isUpToDate, isActive])
  @@index([isIfab, isActive])
  @@index([associationId])
}

model AnswerOption {
  id          String       @id @default(cuid())
  questionId  String
  label       String
  code        String
  isCorrect   Boolean
  order       Int          @default(0)
  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  testAnswers TestAnswer[]
}

model TestSession {
  id              String              @id @default(cuid())
  userId          String
  categoryId      String
  type            QuestionType
  questionIds     String[]
  score           Int?
  totalQuestions  Int                 @default(10)
  completedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  mandatoryTestId String?
  testAnswers     TestAnswer[]
  category        Category            @relation(fields: [categoryId], references: [id])
  mandatoryTest   MandatoryTest?      @relation(fields: [mandatoryTestId], references: [id])
  user            User                @relation(fields: [userId], references: [id])
  completion      UserTestCompletion?

  @@index([userId, createdAt])
  @@index([mandatoryTestId])
}

model TestAnswer {
  id               String        @id @default(cuid())
  testSessionId    String
  questionId       String
  selectedOptionId String?
  isCorrect        Boolean
  createdAt        DateTime      @default(now())
  question         Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   AnswerOption? @relation(fields: [selectedOptionId], references: [id])
  testSession      TestSession   @relation(fields: [testSessionId], references: [id], onDelete: Cascade)
}

model LibraryArticle {
  id         String   @id @default(cuid())
  categoryId String
  title      String
  slug       String   @unique
  content    Json
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  category   Category @relation(fields: [categoryId], references: [id])
}

model TrainingAssignment {
  id          String           @id @default(cuid())
  userId      String
  categoryId  String
  targetScore Int              @default(70)
  status      AssignmentStatus @default(NOT_STARTED)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  category    Category         @relation(fields: [categoryId], references: [id])
  user        User             @relation(fields: [userId], references: [id])
}

model MandatoryTest {
  id              String               @id @default(cuid())
  title           String
  description     String?
  categoryId      String
  dueDate         DateTime?
  lawNumbers      Int[]
  totalQuestions  Int                  @default(10)
  passingScore    Int?
  isActive        Boolean              @default(true)
  createdById     String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  questionIds     String[]
  isMandatory     Boolean              @default(true)
  isUserGenerated Boolean              @default(false)
  includeVar      Boolean              @default(false)
  includeIfab     Boolean              @default(true)
  includeCustom   Boolean              @default(false)
  // Federation scope: null = global (available to everyone).
  associationId   String?
  category        Category             @relation(fields: [categoryId], references: [id])
  createdBy       User                 @relation(fields: [createdById], references: [id])
  association     Association?         @relation(fields: [associationId], references: [id], onDelete: SetNull)
  testSessions    TestSession[]
  completions     UserTestCompletion[]

  @@index([associationId])
}

model UserTestCompletion {
  id              String        @id @default(cuid())
  userId          String
  mandatoryTestId String
  testSessionId   String        @unique
  completedAt     DateTime?
  score           Int?
  passed          Boolean?
  createdAt       DateTime      @default(now())
  mandatoryTest   MandatoryTest @relation(fields: [mandatoryTestId], references: [id])
  testSession     TestSession   @relation(fields: [testSessionId], references: [id])
  user            User          @relation(fields: [userId], references: [id])

  @@unique([userId, mandatoryTestId])
}

model StudyProgress {
  id         String    @id @default(cuid())
  userId     String
  questionId String
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, questionId])
  @@index([userId, isRead])
}

model QuestionFavorite {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
}

model VideoCategory {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  description    String?
  icon           String?
  parentId       String?
  order          Int               @default(0)
  color          String?
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  parent         VideoCategory?    @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children       VideoCategory[]   @relation("CategoryHierarchy")
  videos         VideoClip[]

  @@index([parentId, order])
  @@index([isActive])
}

model Tag {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique
  categoryId     String         // Reference to TagCategory
  parentCategory String?        // For CRITERIA tags: which decision type (Challenges, Handball, etc.)
  color          String?
  linkUrl        String?
  description    String?
  useInVideoLibrary  Boolean     @default(true)
  useInVideoTests    Boolean     @default(true)
  isPlayOnCriteria   Boolean     @default(false) // Criteria-only: true = play-on tag, false = offense tag
  order              Int         @default(0)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  category       TagCategory    @relation(fields: [categoryId], references: [id])
  videos         VideoTag[]

  @@index([isActive, order])
  @@index([categoryId, parentCategory])
  @@unique([name, categoryId, parentCategory])
}

model TagCategory {
  id                 String   @id @default(cuid())
  name               String   @unique
  slug               String   @unique
  description        String?
  color              String?  // Optional color for the category
  canBeCorrectAnswer Boolean  @default(false) // Whether tags in this category can be selected as correct answers
  allowLinks         Boolean  @default(false) // Allow tags to have optional linkUrl
  order              Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tags               Tag[]

  @@index([isActive, order])
}

model DecisionType {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "Challenges", "Handball", "Offside"
  slug        String   @unique
  color       String   // Color used for grouping in UI
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, order])
}

model VideoTag {
  id                String    @id @default(cuid())
  videoId           String
  tagId             String
  assignedAt        DateTime  @default(now())
  isCorrectDecision Boolean   @default(false) // True if this tag is part of the correct answer
  decisionOrder     Int       @default(0)     // Order for correct decision tags (0 for invisible tags)
  tag               Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)
  video             VideoClip @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, tagId])
  @@index([videoId])
  @@index([tagId])
}

model AiPromptConfig {
  id                 String   @id @default(cuid())
  key                String   @unique
  name               String
  description        String?
  systemPrompt       String
  userPromptTemplate String?
  model              String   @default("gpt-4o-mini")
  temperature        Float    @default(0.3)
  maxTokens          Int      @default(2000)
  isActive           Boolean  @default(true)
  updatedAt          DateTime @updatedAt
  updatedById        String?
  updatedBy          User?    @relation(fields: [updatedById], references: [id])

  @@index([key, isActive])
}

enum Role {
  REFEREE
  ADMIN
  SUPER_ADMIN
  DEVELOPER
}

enum CategoryType {
  LOTG
  CHALLENGE
  VAR
  AR
  LIBRARY
}

enum QuestionType {
  LOTG_TEXT
  VIDEO_CHALLENGE
  VAR_CLIP
  AR_CLIP
}

enum AssignmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum VideoType {
  MATCH_CLIP          // Decision-based match footage
  EDUCATIONAL         // Explanation-only, no decision required
  TRAINING            // Skills training
  EXAMPLE             // Example clips
}

enum RestartType {
  DIRECT_FREE_KICK
  INDIRECT_FREE_KICK
  PENALTY_KICK
  CORNER_KICK
  GOAL_KICK
  THROW_IN
  KICK_OFF
  DROPPED_BALL
}

enum SanctionType {
  NO_CARD             // No card / Play on
  YELLOW_CARD         // Yellow card (caution)
  SECOND_YELLOW       // Second yellow card (sending-off)
  RED_CARD_DOGSO      // Red card - Denying an Obvious Goal-Scoring Opportunity
  RED_CARD_SFP        // Red card - Serious Foul Play
  RED_CARD_VC         // Red card - Violent Conduct
  RED_CARD_OTHER      // Red card - Other sending-off offense
}

enum OffsideReason {
  INTERFERING_WITH_PLAY        // Active interference with play
  INTERFERING_WITH_OPPONENT    // Active interference with opponent
  GAINING_ADVANTAGE            // Gaining advantage from position
  NOT_OFFSIDE                  // Not in offside position / Not offside
}

enum VideoTestType {
  MANDATORY  // Admin-created, user must complete by due date
  PUBLIC     // Admin-created, available to all
  USER       // User-created, saved to "My Tests"
}

model VideoTest {
  id              String         @id @default(cuid())
  name            String
  description     String?
  type            VideoTestType
  totalClips      Int            @default(10)
  passingScore    Int?
  maxViewsPerClip Int?
  dueDate         DateTime?
  adminFilters    Json?
  isActive        Boolean        @default(true)
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  // Federation scope: null = global (available to everyone).
  associationId   String?
  createdBy       User?          @relation(fields: [createdById], references: [id])
  association     Association?   @relation(fields: [associationId], references: [id], onDelete: SetNull)
  clips           VideoTestClip[]
  sessions        VideoTestSession[]
  completions     VideoTestCompletion[]

  @@index([type, isActive])
  @@index([createdById])
  @@index([associationId])
}

model VideoTestClip {
  id           String    @id @default(cuid())
  videoTestId  String
  videoClipId  String
  order        Int       @default(0)
  videoTest    VideoTest @relation(fields: [videoTestId], references: [id], onDelete: Cascade)
  videoClip    VideoClip @relation(fields: [videoClipId], references: [id], onDelete: Cascade)

  @@unique([videoTestId, videoClipId])
  @@index([videoTestId])
  @@index([videoClipId])
}

model VideoTestSession {
  id              String           @id @default(cuid())
  userId          String
  videoTestId     String
  clipIds         String[]         // ordered video clip IDs
  totalClips      Int              @default(0)
  maxViewsPerClip Int?
  clipViewCounts  Json?
  score           Int?
  completedAt     DateTime?
  submittedAt     DateTime?
  totalAnswerTimeMs Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  videoTest       VideoTest       @relation(fields: [videoTestId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers         VideoTestAnswer[]
  completion      VideoTestCompletion?

  @@index([userId, createdAt])
  @@index([videoTestId])
}

model VideoTestAnswer {
  id               String           @id @default(cuid())
  videoTestSessionId String
  videoClipId      String
  playOnNoOffence Boolean          @default(false)
  restartTagId     String?
  sanctionTagId    String?
  criteriaTagIds   String[]         @default([])
  timeToAnswerMs   Int?
  questionStartedAt DateTime?
  questionAnsweredAt DateTime?
  isCorrect        Boolean          // full match
  isPartial        Boolean          @default(false) // at least one category correct
  session          VideoTestSession @relation(fields: [videoTestSessionId], references: [id], onDelete: Cascade)

  @@unique([videoTestSessionId, videoClipId])
  @@index([videoTestSessionId])
}

model VideoTestCompletion {
  id              String           @id @default(cuid())
  userId          String
  videoTestId     String
  videoTestSessionId String        @unique
  completedAt     DateTime?
  score           Int?
  passed          Boolean?
  createdAt       DateTime        @default(now())
  videoTest       VideoTest       @relation(fields: [videoTestId], references: [id], onDelete: Cascade)
  session         VideoTestSession @relation(fields: [videoTestSessionId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, videoTestId])
  @@index([userId])
  @@index([videoTestId])
}

// ─── Assistant Referee (offside) practice ───
// Completely separate clip bank from the Video Library / video tests.

enum ArDecision {
  OFFSIDE
  ONSIDE
}

model ArClip {
  id             String     @id @default(cuid())
  title          String
  fileUrl        String
  thumbnailUrl   String?
  duration       Float?     // seconds
  correctAnswer  ArDecision
  passMomentTime Float?     // seconds into the clip where the pass is made
  passFrameUrl   String?    // captured freeze-frame image at the moment of the pass
  description    String?
  isActive       Boolean    @default(true)
  createdById    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  createdBy      User?      @relation(fields: [createdById], references: [id])
  answers        ArTestAnswer[]

  @@index([isActive, createdAt])
}

model ArTestSession {
  id                String    @id @default(cuid())
  userId            String
  clipIds           String[]  // ordered AR clip IDs for this attempt
  totalClips        Int       @default(0)
  score             Int?
  completedAt       DateTime?
  submittedAt       DateTime?
  totalAnswerTimeMs Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers           ArTestAnswer[]

  @@index([userId, createdAt])
}

model ArTestAnswer {
  id              String        @id @default(cuid())
  arTestSessionId String
  arClipId        String
  userAnswer      ArDecision
  isCorrect       Boolean
  timeToAnswerMs  Int?
  createdAt       DateTime      @default(now())
  session         ArTestSession @relation(fields: [arTestSessionId], references: [id], onDelete: Cascade)
  clip            ArClip        @relation(fields: [arClipId], references: [id], onDelete: Cascade)

  @@unique([arTestSessionId, arClipId])
  @@index([arTestSessionId])
  @@index([arClipId])
}

// Stores admin feedback on AI-generated search descriptions.
// Used to track hallucinations, embellishments, and translation errors
// so the system prompt can be iteratively improved.
model AiGenerationFeedback {
  id              String    @id @default(cuid())
  videoId         String
  videoTitle      String?
  // What was sent into the AI
  rawInput        String    @db.Text
  existingTags    String?   @db.Text
  // What the AI produced
  aiOutput        String    @db.Text
  aiSuggestedTags String[]  @default([])
  // Structured feedback
  rating          Int       // 1–5: 1=hallucination/wrong, 3=ok, 5=great
  issueType       String?   // "hallucination" | "embellishment" | "wrong_tag" | "translation" | "too_short" | "other"
  note            String?   @db.Text
  // Who flagged it
  createdById     String
  createdAt       DateTime  @default(now())

  video           VideoClip @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdBy       User      @relation(fields: [createdById], references: [id])

  @@index([videoId])
  @@index([createdById])
  @@index([createdAt])
}

// Logs every semantic search query made by users.
// Used by developers to spot irrelevant results and improve the AI model.
// Can be toggled off via DeveloperSettings.searchLoggingEnabled.
model SearchQueryLog {
  id                  String    @id @default(cuid())
  userId              String
  rawQuery            String
  expandedQuery       String?
  detectedLanguage    String?
  inferredTags        Json?     // Array of {tagSlug, confidence}
  selectedTagFilters  String[]  @default([])
  resultVideoIds      String[]  @default([])
  resultCount         Int       @default(0)
  searchMethod        String    @default("keyword")  // "semantic" | "keyword"
  durationMs          Int?
  createdAt           DateTime  @default(now())

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// Singleton developer configuration record (id = "default").
// Stores feature flags controllable from the developer UI without a redeploy.
model DeveloperSettings {
  id                    String  @id @default("default")
  searchLoggingEnabled  Boolean @default(true)
  updatedAt             DateTime @updatedAt
}
